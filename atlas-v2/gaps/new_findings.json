 {
  "id": "lc-icpet-impaired-extraction",
  "target_domain": "muscle-exertion",
  "subdomain": "Oxygen delivery and extraction",
  "finding": "Invasive CPET in long COVID with exercise intolerance repeatedly shows low systemic oxygen extraction with normal or high cardiac output, and in a subset reduced biventricular filling (preload failure), mirroring ME/CFS iCPET findings.",
  "grade": "several",
  "plain": "When doctors measure oxygen in arteries and veins during exercise, many long COVID patients' muscles take less oxygen out of the blood even though the heart pumps plenty. Some also have too little blood returning to the heart.",
  "detail": "Should cross-link to vascular-oxygen-extraction and muscle-exertion-oxygen-extraction.",
  "studies": [
   {
    "cite": "Kahn 2024, ERJ Open Res",
    "n": "55 LC",
    "design": "retrospective iCPET",
    "result": "75% impaired peak O2 extraction with supranormal cardiac output; about 25% had HFpEF or exercise pulmonary hypertension",
    "url": "https://doi.org/10.1183/23120541.00714-2023",
    "doi": "10.1183/23120541.00714-2023",
    "verified": true
   },
   {
    "cite": "Leitner 2024, Pulm Circ",
    "n": "47 LC",
    "design": "iCPET + metabolomics",
    "result": "reduced peak extraction, worse after severe acute infection; metabolomic shifts",
    "url": "https://doi.org/10.1002/pul2.70009",
    "doi": "10.1002/pul2.70009",
    "verified": true
   },
   {
    "cite": "Singh I 2023, Pulm Circ",
    "n": "21 LC",
    "design": "iCPET + plasma proteomics",
    "result": "low systemic O2 extraction; endotheliopathy proteomic signature",
