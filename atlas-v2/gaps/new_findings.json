  "id": "lc-pem-provocation-response",
  "target_domain": "muscle-exertion",
  "subdomain": "PEM definition and timing",
  "finding": "Whether standardised exercise provokes measurable post-exertional symptom worsening in long COVID is contested: a crossover RCT found no greater 48-h fatigue than controls, while symptom-tracking studies find variable PESE peaking within 72 h in subsets.",
  "grade": "contested",
  "plain": "Trials disagree on whether a single exercise session reliably makes long COVID patients worse in the days after; some patients clearly crash, others do not.",
  "detail": "Tryfonos 2024 did not select for PEM; result likely depends on case definition.",
  "studies": [
   {
    "cite": "Berardi 2026, Med Sci Sports Exerc",
    "n": "30 ME/CFS, 30 PASC, 30 controls",
    "design": "prospective post-exercise symptom tracking",
    "result": "variable PESE in PASC, peaking within 72 h",
