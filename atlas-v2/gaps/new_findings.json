[
 {
  "id": "muscle-exertion-lc-peak-vo2",
  "target_domain": "muscle-exertion",
  "subdomain": "Exercise capacity (single CPET)",
  "finding": "People with long COVID have lower peak VO2 than recovered controls on average (about 5 ml/kg/min), with patterns pointing to deconditioning, chronotropic incompetence and impaired peripheral extraction rather than a cardiac or ventilatory limit.",
  "grade": "several",
  "plain": "On an exercise bike, people with long COVID reach a lower maximum oxygen use than people who recovered. The heart's pumping is usually normal; the problem looks more like heart-rate control, fitness loss and muscles taking up less oxygen.",
  "detail": "Bridges ME/CFS single-CPET findings to LC; selection (hospitalised vs mild, active vs sedentary) explains much of the heterogeneity.",
  "studies": [
   {
    "cite": "Durstenfeld 2022, JAMA Netw Open",
    "n": "9 studies; 464 with PASC vs 359 without",
    "design": "systematic review and meta-analysis of CPET",
    "result": "peak VO2 -4.9 ml/kg/min (95% CI -6.4 to -3.4); low certainty; deconditioning, dysfunctional breathing, chronotropic incompetence and impaired extraction all reported",
    "url": "https://doi.org/10.1001/jamanetworkopen.2022.36057",
    "doi": "10.1001/jamanetworkopen.2022.36057",
    "verified": true
   },
   {
    "cite": "Jamieson 2024, Physiol Rep",
    "n": "32 LC vs 19 recovered",
    "design": "case-control CPET + NIRS + vascular function",
    "result": "lower OUES and anaerobic threshold; lower NIRS-measured muscle oxidative capacity; no macro/microvascular dysfunction",
    "url": "https://doi.org/10.14814/phy2.15940",
    "doi": "10.14814/phy2.15940",
    "verified": true
   },
   {
    "cite": "Howden 2026, Am J Physiol Heart",
    "n": "35 LC vs 12 controls",
    "design": "case-control CPET, cardiac reserve, MSNA",
    "result": "lower peak VO2 and heart-rate reserve; cardiac reserve and resting MSNA normal",
    "url": "https://doi.org/10.1152/ajpheart.90275.2026",
    "doi": "10.1152/ajpheart.90275.2026",
    "verified": true
   }
  ],
  "contradicting": [
   {
    "cite": "Mustonen 2024, BMC Cardiovasc Disord",
    "n": "101 LC",
    "design": "cohort CPET",
    "result": "mean exercise capacity normal; distinct subgroups with chronotropic incompetence and dysautonomic breathing",
    "url": "https://doi.org/10.1186/s12872-024-04081-w",
    "doi": "10.1186/s12872-024-04081-w",
    "verified": true
   },
   {
    "cite": "Rodrigues 2026, J Pers Med",
    "n": "38 young, physically active LC",
    "design": "case-control CPET",
    "result": "normal cardiopulmonary responses",
    "url": "https://doi.org/10.3390/jpm16010038",
    "doi": "10.3390/jpm16010038",
    "verified": true
   }
  ],
  "hypotheses": [],
  "open_questions": [
   "Does peak VO2 in LC with PEM differ from LC without PEM?"
  ],
  "test_available": false
